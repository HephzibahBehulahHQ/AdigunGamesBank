# Copy to platform/.env on the API host; never commit populated secrets.
APP_ENV=production
AI_MODE=live
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
# Public registration is off by default in production. Enable only with account,
# abuse and provider-budget controls appropriate to your deployment.
ALLOW_REGISTRATION=false
ADMIN_EMAIL=
ADMIN_BOOTSTRAP_TOKEN=
CORS_ORIGINS=https://adigungamesbank.hephzibahbehulah.com,https://hephzibahbehulahhq.github.io
ARENA_MAX_CONCURRENT_MATCHES=4

# Select active model identifiers available to your provider accounts.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
XAI_API_KEY=
GROK_MODEL=
KIMI_API_KEY=
KIMI_MODEL=
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Adigun AI is an operator-deployed OpenAI-compatible service, not a fabricated
# independent foundation model. All three values are required; no default exists.
ADIGUN_AI_API_KEY=
ADIGUN_AI_MODEL=
ADIGUN_AI_BASE_URL=

# Optional local/cloud Ollama service. Local HTTP is permitted only for
# localhost, 127.0.0.1, ::1 or host.docker.internal. Keep private services private.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_API_KEY=

# Explicitly choose one configured provider key, e.g. ollama. The judge uses
# that provider's model. Exclude it from contenders to avoid self-judging gaps.
JUDGE_PROVIDER=
